# Groq key: used only by the server-side /api/llm proxy, never shipped to the browser
GROQ_API_KEY=your_groq_key_here
# Optional: several keys, comma-separated; the proxy rotates to the next one on a rate limit
# GROQ_API_KEYS=gsk_key1,gsk_key2
# Optional: override when Groq retires a model
# GROQ_TEXT_MODEL=openai/gpt-oss-120b
# GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
# GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Optional: AI requests per visitor IP per minute (0 = no limit)
# LLM_RATE_LIMIT_PER_MIN=40
