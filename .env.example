# Groq LLM (coach + personalized insights)
VITE_GROQ_API_KEY=your_groq_key_here

# WHOOP Developer API (optional — app runs on labeled sample data without these)
# Client ID is public (used in the browser OAuth redirect).
VITE_WHOOP_CLIENT_ID=your_whoop_client_id
VITE_WHOOP_REDIRECT_URI=http://localhost:3000/whoop/callback

# Server-only secret for the token exchange — NEVER exposed to the browser.
WHOOP_CLIENT_ID=your_whoop_client_id
WHOOP_CLIENT_SECRET=your_whoop_client_secret
